map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_cloudfront_viewer_address $adsb_client_address {
    default $http_cloudfront_viewer_address;
    "" $binary_remote_addr;
}

limit_req_zone $adsb_client_address zone=adsb_api_ip:10m rate=30r/s;
limit_req_zone $adsb_client_address zone=adsb_auth_ip:10m rate=5r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 20m;

    location = /adsb-data/status {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/aircraft {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/aircraft$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/registry/status {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/faa/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /adsb-data/aircraft/icao/ {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/aircraft/icao/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/auth/enroll {
        limit_req zone=adsb_auth_ip burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/auth/enroll;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/auth/token {
        limit_req zone=adsb_auth_ip burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/auth/token;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/adsb-data/auth/app-attest/(challenge|register|recover)$ {
        limit_req zone=adsb_auth_ip burst=3 nodelay;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:8080/v1/auth/app-attest/$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-App-Client-Address $adsb_client_address;
        add_header Cache-Control "no-store" always;
    }

    location = /proxy {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ^~ /proxy/ {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /chat {
        return 308 /chat/;
    }

    location ^~ /chat/ {
        proxy_pass http://127.0.0.1:3040;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    include /etc/nginx/snippets/bugmoog-stats-location.conf;

    location / {
        return 404;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name 3-215-147-252.sslip.io;

    ssl_certificate /etc/letsencrypt/live/3-215-147-252.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/3-215-147-252.sslip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;

    location = /adsb-data/status {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/aircraft {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/aircraft$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/registry/status {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/faa/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /adsb-data/aircraft/icao/ {
        limit_req zone=adsb_api_ip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/aircraft/icao/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/auth/enroll {
        limit_req zone=adsb_auth_ip burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/auth/enroll;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location = /adsb-data/auth/token {
        limit_req zone=adsb_auth_ip burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080/v1/auth/token;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/adsb-data/auth/app-attest/(challenge|register|recover)$ {
        limit_req zone=adsb_auth_ip burst=3 nodelay;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:8080/v1/auth/app-attest/$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-App-Client-Address $adsb_client_address;
        add_header Cache-Control "no-store" always;
    }

    location = /proxy {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ^~ /proxy/ {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /chat {
        return 308 /chat/;
    }

    location ^~ /chat/ {
        proxy_pass http://127.0.0.1:3040;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    include /etc/nginx/snippets/bugmoog-stats-location.conf;

    location / {
        return 404;
    }
}
