[Unit]
Description=Bugmoog aggregate statistics service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bugmoog-stats
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3050
Environment=DATA_DIR=/var/lib/bugmoog-stats
Environment=ALLOWED_ORIGINS=https://pugmoog.github.io
ExecStart=/usr/local/bin/node /opt/bugmoog-stats/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bugmoog-stats

[Install]
WantedBy=multi-user.target
